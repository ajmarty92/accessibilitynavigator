# Copy this file to .env and fill in real values before running.

# --- REST API auth ---------------------------------------------------------
# Shared secret the Android app sends as the `X-API-Key` header on every
# /api/v1/* request. Generate something random, e.g.: openssl rand -hex 32
API_KEY=

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Database -----------------------------------------------------------------
# SQLite file path. NOTE: Prisma resolves a relative `file:` path relative to
# the prisma/ directory, not the project root — an absolute path avoids the
# confusion entirely (this is what docker-compose.yml uses). For local dev
# the relative form below works fine too.
DATABASE_URL="file:../data/twitter-monitor.db"

# --- X/Twitter login (agent-twitter-client) ---------------------------------
# READ backend/README.md before filling these in: this is an unofficial,
# reverse-engineered scraping method that violates X's Terms of Service.
# Use a dedicated/burner X account here — NOT your or your brother's main
# personal account — to limit the blast radius if X detects and bans it.
TWITTER_USERNAME=
TWITTER_PASSWORD=
# Only needed if the account has email confirmation / login verification
# enabled (X often prompts for this on unrecognized-client logins).
TWITTER_EMAIL=

# Where the authenticated session's cookies are cached to disk, so the
# service doesn't have to log in again on every restart (repeated logins are
# a strong bot-detection signal). Must be on a persistent volume in Docker.
COOKIE_CACHE_PATH=./data/twitter-cookies.json

# --- Polling ------------------------------------------------------------------
# How often (ms) to poll tracked accounts for new tweets. Default: 5 minutes.
POLL_INTERVAL_MS=300000

# --- Firebase Cloud Messaging -------------------------------------------------
# Path to the Firebase service account JSON key file (see backend/README.md
# for how to create one). Must be readable by the process/container.
FIREBASE_SERVICE_ACCOUNT_PATH=./data/firebase-service-account.json
