// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // bcrypt hash; null for accounts without password auth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}

// Every account belongs to at least one Organization — a fresh signup gets
// a personal one automatically (see lib/organizations.ts), so the org
// model applies uniformly instead of needing a separate "solo user" code
// path. Scans, billing, and API keys all hang off the org, not the user
// directly, so a team can share scan history/quota and a user can belong
// to more than one org (e.g. a consultant auditing several clients).
model Organization {
  id               String   @id @default(cuid())
  name             String
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships  Membership[]
  scans        Scan[]
  apiKeys      ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  accessibilityStatements AccessibilityStatement[]
  subscription Subscription?
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner, admin, member
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// Machine-to-machine credentials for the CI integration and any future
// programmatic access. Only the tier's api_access flag (PRICING_TIERS in
// lib/stripe.ts) gates issuance — the key itself carries no scope beyond
// "act as this organization" for scanning endpoints. Only keyHash is
// stored; the plaintext key is shown to the user exactly once, at creation.
model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String?      // audit trail only, not an access-control boundary
  name            String
  keyPrefix       String       // first chars of the key, shown for identification
  keyHash         String       @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

// Outbound notifications gated by the same api_access feature as ApiKey.
// Only `secret` is stored (needed to sign future deliveries); it's shown
// to the user once at creation, same as an API key's plaintext value.
model WebhookEndpoint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String?      // audit trail only, not an access-control boundary
  url             String
  secret          String       // used to HMAC-sign delivered payloads
  enabled         Boolean      @default(true)
  lastDeliveryAt  DateTime?
  lastDeliveryStatus Int?      // HTTP status of the most recent delivery attempt
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

// Sliding-window rate limiting for auth and scan endpoints.
// Keyed by an arbitrary string (e.g. "register:<ip>", "scan:<userId>")
// so a single table can back multiple limiters.
model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Scan {
  id              String      @id @default(cuid())
  url             String
  timestamp       DateTime    @default(now())
  complianceScore Int
  pagesScanned    Int
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String?     // audit trail only — who ran it, not an access-control boundary
  violations      Violation[]
  metadata        ScanMetadata?
  manualAuditItems ManualAuditItem[]
  accessibilityStatements AccessibilityStatement[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([organizationId])
  @@index([timestamp])
}

// A publishable accessibility statement — the public-facing page DOJ
// guidance and plaintiffs' counsel specifically look for, distinct from
// the VPAT (a detailed vendor conformance document for procurement).
// Keyed by (organizationId, siteUrl) rather than a single scan, so
// re-running this generator against a newer scan of the same site updates
// the statement's content and refreshes `scan` without changing the
// public slug — a published statement's URL needs to stay stable even as
// the underlying scan data improves over time.
model AccessibilityStatement {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanId           String       // most recent scan this statement was generated/refreshed from
  scan             Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  siteUrl          String
  slug             String       @unique
  organizationName String
  contactEmail     String?
  contactPhone     String?
  customNotes      String?      @db.Text
  published        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, siteUrl])
  @@index([organizationId])
}

// Automated tools like axe-core only catch a fraction of real WCAG
// failures — screen reader behavior, keyboard traps, reading order, and
// color-alone cues can't be verified by DOM inspection. This table backs a
// human sign-off checklist per scan, seeded from a fixed template
// (lib/manual-audit-checklist.ts) and completed by a real person.
model ManualAuditItem {
  id              String    @id @default(cuid())
  scanId          String
  scan            Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category        String    // keyboard-navigation, screen-reader, reading-order, color-and-contrast, zoom-and-reflow, forms
  code            String    // stable key within the template, e.g. "kbd-no-traps"
  title           String
  guidance        String    @db.Text
  wcagReference   String?
  status          String    @default("not_started") // not_started, pass, fail, not_applicable
  notes           String?   @db.Text
  checkedByUserId String?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scanId, code])
  @@index([scanId])
}

model ScanMetadata {
  id              String    @id @default(cuid())
  scanId          String    @unique
  scan            Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  frameworkDetection Json?   // Framework detection results
  performanceMetrics Json?   // Performance metrics
  scanOptions       Json?    // Scan options used
  aiAnalysisEnabled Boolean  @default(false)
  codeFixesEnabled  Boolean  @default(false)
  customRulesEnabled Boolean @default(false)
  performanceAnalysis Boolean @default(false)
  frameworkDetectionEnabled Boolean @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Subscription {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String @unique
  tier            String    // starter, professional, enterprise
  status          String    // active, canceled, past_due, incomplete
  currentPeriodEnd Int       // Unix timestamp
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
}

model CodeFix {
  id              String    @id @default(cuid())
  violationId     String
  scanId          String
  framework       String   // react, vue, angular, html, svelte
  originalCode    String    @db.Text
  fixedCode       String    @db.Text
  explanation     String    @db.Text
  steps           Json      // Implementation steps
  testingRecommendations Json // Testing recommendations
  browserCompatibility Json   // Browser compatibility notes
  additionalImprovements Json // Additional improvements
  beforeAfter      Json?     // Before/after comparison
  cssClasses       Json?     // CSS class changes
  isValidated      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([violationId])
  @@index([scanId])
  @@index([framework])
}

model UsageEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // scan_completed, site_added, feature_used
  metadata    Json?    // Additional event data
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
}

model Violation {
  id              String   @id @default(cuid())
  scanId          String
  scan            Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  violationId     String   // axe violation ID
  description     String   @db.Text
  help            String   @db.Text
  helpUrl         String?
  impact          String   // minor, moderate, serious, critical
  wcagReference   String?
  elementCount    Int      @default(0)
  priority        String?  // critical, high, medium, low
  priorityScore   Float?
  impactScore     Float?
  legalRiskScore  Float?
  userImpactScore Float?
  businessRiskScore Float?
  technicalComplexity Float?
  effortHours     Float?
  explanation     String?  @db.Text
  fixRecommendations Json? // Store fix recommendations as JSON array
  complianceDeadline String?
  businessJustification String? @db.Text
  nodes           Json     // Store violation nodes as JSON
  tags            Json     // Store tags as JSON array
  framework       String?  // react, vue, angular, etc.
  customRule      String?  // ID of custom accessibility rule
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scanId])
  @@index([priority])
  @@index([impact])
  @@index([framework])
}