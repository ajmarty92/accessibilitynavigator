# Anthropic API Key for AI prioritization
ANTHROPIC_API_KEY=your_api_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Accessibility Navigator

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/accessibility_navigator

# Authentication (required — scanning requires a signed-in user)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_here

# Stripe billing
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# From the Stripe CLI or dashboard webhook settings
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Transactional email (Brevo) — used for scheduled monitor regression alerts
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_ADDRESS=alerts@yourdomain.com
EMAIL_FROM_NAME=Accessibility Navigator

# Shared secret for the scheduled-monitor cron endpoint
# (POST /api/cron/run-monitors). Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# GitHub App (PR automation) — lets the CI Action post/update a comment on
# a pull request with new violations. Create the App at
# https://github.com/settings/apps/new: permissions Pull requests
# (read & write) + Metadata (read-only); subscribe to the "Installation"
# webhook event pointed at <your-deployment>/api/github/webhook. Optional:
# everything else in the app works without these — only the PR-comment
# feature is skipped when they're unset.
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_SLUG=your-github-app-slug
# Paste the downloaded .pem private key with real newlines replaced by \n
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_WEBHOOK_SECRET=your_github_app_webhook_secret_here